#!/bin/sh
# Netgate 1100 switch setup for OPNsense.
# Install to: /usr/local/etc/rc.syshook.d/early/05-switch  (chmod +x)
#
# Marvell 88E6341: port0 = CPU (mvneta0), ports 1-3 = front ports.
#   WAN = port3 -> VLAN 4090
#   LAN = port2 -> VLAN 4091
#   OPT = port1 -> VLAN 4092
# Each front port is untagged in its own VLAN; the CPU port carries all three tagged.

kldload -n e6000sw
etherswitchcfg config vlan_mode dot1q
etherswitchcfg vlangroup0 vlan 4090 members 0t,3
etherswitchcfg vlangroup1 vlan 4091 members 0t,2
etherswitchcfg vlangroup2 vlan 4092 members 0t,1
etherswitchcfg port3 pvid 4090
etherswitchcfg port2 pvid 4091
etherswitchcfg port1 pvid 4092
